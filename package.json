{
  "name": "photnoo",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @photnoo/db generate",
    "db:migrate": "pnpm --filter @photnoo/db migrate:dev",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "db:local": "node scripts/local-postgres.mjs",
    "applications": "pnpm --filter @photnoo/api cli:applications"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.11.5",
    "typescript": "^5.9.3"
  }
}
