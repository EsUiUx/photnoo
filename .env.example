# Copy to .env for local development. Dummy values only - real secrets live in AWS Secrets Manager.
NODE_ENV=development

# API
API_PORT=4000
TRUST_PROXY_HOPS=0
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://photnoo:photnoo@localhost:5432/photnoo
REDIS_URL=redis://localhost:6379

# Auth (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Object storage: "s3" = MinIO locally (docker compose) or Cloudflare R2; "local" = files on disk, no Docker
STORAGE_DRIVER=s3
LOCAL_STORAGE_DIR=.local/storage
PUBLIC_API_URL=http://localhost:4000
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=photnoo-media
S3_ACCESS_KEY_ID=photnoo
S3_SECRET_ACCESS_KEY=photnoo-secret

# Email (Mailpit locally)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="Photnoo <no-reply@photnoo.local>"

# Billing (PRD B-03, B-04). Placeholders until the owner provides real details.
COMPANY_NAME=Photnoo
COMPANY_ADDRESS="Cairo, Egypt"
COMPANY_EMAIL=billing@photnoo.com
PAY_INSTAPAY_HANDLE=DEMO-instapay-handle
PAY_VODAFONE_CASH_NUMBER=DEMO-01000000000
PAY_BANK_NAME="DEMO Bank"
PAY_BANK_ACCOUNT_NAME="Photnoo (demo)"
PAY_BANK_ACCOUNT_NUMBER=DEMO-0000000000

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000
